<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RootNamespace>TradingHub.App</RootNamespace>
    <AssemblyName>TradingHub</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\tradinghub.ico</ApplicationIcon>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\TradingHub.Core\TradingHub.Core.csproj" />
    <ProjectReference Include="..\TradingHub.Strategies\TradingHub.Strategies.csproj" />
    <ProjectReference Include="..\TradingHub.Sdk\TradingHub.Sdk.csproj" />
    <ProjectReference Include="..\TradingHub.Charting\TradingHub.Charting.csproj" />
    <ProjectReference Include="..\TradingHub.Scripting\TradingHub.Scripting.csproj" />
    <ProjectReference Include="..\TradingHub.Indicators.Native\TradingHub.Indicators.Native.csproj" />
    <ProjectReference Include="..\TradingHub.Indicators.Technical\TradingHub.Indicators.Technical.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="$(AvaloniaVersion)" />
    <PackageReference Include="Avalonia.Desktop" Version="$(AvaloniaVersion)" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="$(AvaloniaVersion)" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="$(AvaloniaVersion)" />
    <PackageReference Include="Avalonia.Controls.ColorPicker" Version="$(AvaloniaVersion)" />
    <PackageReference Include="Avalonia.Skia" Version="$(AvaloniaVersion)" />
    <PackageReference Include="Material.Icons.Avalonia" Version="2.3.1" />
    <PackageReference Include="Avalonia.AvaloniaEdit" Version="11.4.1" />
    <PackageReference Include="AvaloniaEdit.TextMate" Version="11.4.1" />
  </ItemGroup>
  <ItemGroup>
    <None Remove="Assets/**" />
    <AvaloniaResource Include="Assets/**" Exclude="Assets/*.icns;Assets/icon-512.png" />
    <!-- traducciones de la interfaz (las arma tools/TradingHub.I18n) -->
    <EmbeddedResource Include="Localization/*.json" LogicalName="TradingHub.App.Localization.%(Filename)%(Extension)" WithCulture="false" />
  </ItemGroup>
</Project>
